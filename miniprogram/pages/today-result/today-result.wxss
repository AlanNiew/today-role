.result-card {
  background: linear-gradient(150deg, #2f5643 0%, #1b3428 100%);
  border-radius: 36rpx;
  box-shadow: 0 28rpx 60rpx rgba(31, 59, 44, 0.24);
  box-sizing: border-box;
  color: #f8f2e4;
  margin: 18rpx 0 28rpx;
  overflow: hidden;
  padding: 38rpx 34rpx 32rpx;
  position: relative;
}

.result-orbit {
  border: 1rpx solid rgba(240, 205, 141, 0.2);
  border-radius: 50%;
  height: 330rpx;
  position: absolute;
  right: -120rpx;
  top: -110rpx;
  width: 330rpx;
}

.result-orbit--inner {
  height: 210rpx;
  right: -60rpx;
  top: -50rpx;
  width: 210rpx;
}

.result-meta {
  color: rgba(248, 242, 228, 0.52);
  display: flex;
  font-size: 19rpx;
  justify-content: space-between;
  letter-spacing: 3rpx;
  position: relative;
  z-index: 1;
}

.result-kicker {
  color: rgba(248, 242, 228, 0.62);
  font-size: 23rpx;
  letter-spacing: 2rpx;
  margin-top: 34rpx;
  position: relative;
  z-index: 1;
}

.result-label {
  color: #f6e7c4;
  font-family: "Songti SC", "Noto Serif CJK SC", "STSong", serif;
  font-size: 62rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.32;
  margin: 8rpx 0 24rpx;
  position: relative;
  z-index: 1;
}

.result-rule {
  background: linear-gradient(90deg, #d8b06c, rgba(216, 176, 108, 0));
  height: 2rpx;
  margin-bottom: 22rpx;
  position: relative;
  width: 140rpx;
  z-index: 1;
}

.result-desc {
  color: rgba(248, 242, 228, 0.82);
  font-size: 28rpx;
  line-height: 1.8;
  position: relative;
  z-index: 1;
}

.anchor-grid {
  display: flex;
  margin: 30rpx -6rpx 0;
  position: relative;
  z-index: 1;
}

.anchor-tile {
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  border-radius: 16rpx;
  box-sizing: border-box;
  flex: 1;
  margin: 0 6rpx;
  padding: 16rpx 14rpx;
}

.anchor-value {
  color: #f0cd8d;
  font-family: "Songti SC", "Noto Serif CJK SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.anchor-label {
  color: rgba(248, 242, 228, 0.5);
  font-size: 20rpx;
  line-height: 1.4;
  margin-top: 4rpx;
}

.note-text {
  color: #3d4b41;
  font-size: 29rpx;
  line-height: 1.75;
}
