<view class="page">
  <view class="row-between">
    <view>
      <view class="section-title">TODAY</view>
      <view class="card-title" style="font-size: 40rpx;">{{todayLabel}}</view>
    </view>
    <view wx:if="{{hasEntry}}" class="tag">今天已记录</view>
  </view>

  <view class="muted" style="margin: 4rpx 4rpx 28rpx;">选一个状态、一个场景，5 秒就够。之后随时可以改。</view>

  <view class="card">
    <view class="row-between" style="margin-bottom: 20rpx;">
      <view class="card-title" style="margin-bottom: 0;">今天的状态</view>
      <view class="badge-counter">1 / 2</view>
    </view>
    <view class="chips">
      <view
        wx:for="{{statuses}}"
        wx:key="*this"
        class="chip {{selectedStatus === item ? 'active' : ''}}"
        data-value="{{item}}"
        bindtap="onSelectStatus"
      >{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="row-between" style="margin-bottom: 20rpx;">
      <view class="card-title" style="margin-bottom: 0;">发生在哪里</view>
      <view class="badge-counter">2 / 2</view>
    </view>
    <view class="chips">
      <view
        wx:for="{{scenes}}"
        wx:key="*this"
        class="chip {{selectedScene === item ? 'active' : ''}}"
        data-value="{{item}}"
        bindtap="onSelectScene"
      >{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="row-between" style="margin-bottom: 16rpx;">
      <view class="card-title" style="margin-bottom: 0;">留一句话</view>
      <view class="muted small">{{note.length}} / 100</view>
    </view>
    <textarea
      class="note-input"
      value="{{note}}"
      maxlength="100"
      placeholder="可选。只保存在本机，不会用于生成文案。"
      placeholder-class="muted"
      bindinput="onNoteInput"
      auto-height
    />
  </view>

  <button
    class="btn btn-primary"
    style="margin-top: 12rpx;"
    loading="{{saving}}"
    disabled="{{saving || loading}}"
    bindtap="onSave"
  >{{hasEntry ? '更新今天的记录' : '保存今天的记录'}}</button>

  <view class="footer-note">记录只写在本机存储，不会上传，也不会分享给任何人。</view>
</view>
