<view class="page home-page">
  <view class="hero reveal">
    <view class="hero__top">
      <view class="brand">
        <view class="brand-mark serif">今</view>
        <view>
          <view class="eyebrow">TODAY · {{todayWeekday}}</view>
          <view class="hero__date">{{todayMonthDay}}</view>
        </view>
      </view>
      <view class="tag {{hasEntry ? 'tag--sage' : 'tag--outline'}}">{{hasEntry ? '今天已记录' : '5 秒记录'}}</view>
    </view>

    <view class="hero__title">{{greeting}}，<text class="serif hero__accent">感觉如何？</text></view>
    <view class="hero__sub">{{hasEntry ? '今天记录了「' + todayCombo + '」' : '选状态与场景，5 秒生成今日碎片。'}}</view>

    <view class="hero__orbit"></view>
    <view class="hero__orbit-dot"></view>
  </view>

  <view class="card reveal reveal-2">
    <view class="section-head">
      <view class="section-title">01 · 今天的状态</view>
      <view class="section-note">
        <text class="section-help" hover-class="btn-hover" bindtap="onShowStatusHelp">说明</text>
        <text> · 单选</text>
      </view>
    </view>
    <view class="status-grid">
      <view
        wx:for="{{statusOptions}}"
        wx:key="label"
        class="status-option {{selectedStatus === item.label ? 'is-selected' : ''}}"
        hover-class="btn-hover"
        data-value="{{item.label}}"
        bindtap="onSelectStatus"
      >
        <view class="status-dot status-dot--{{item.tone}}"></view>
        <view class="status-name">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="card reveal reveal-3">
    <view class="section-head">
      <view class="section-title">02 · 主要和什么有关</view>
      <view class="section-note">
        <text class="section-help" hover-class="btn-hover" bindtap="onShowSceneHelp">说明</text>
        <text> · 单选</text>
      </view>
    </view>
    <view class="scene-grid">
      <view
        wx:for="{{sceneOptions}}"
        wx:key="label"
        class="scene-option {{selectedScene === item.label ? 'is-selected' : ''}}"
        hover-class="btn-hover"
        data-value="{{item.label}}"
        bindtap="onSelectScene"
      >{{item.label}}</view>
    </view>

    <view class="combo-preview {{selectedStatus && selectedScene ? 'is-ready' : ''}}">
      <view class="combo-label">TODAY'S COMBO</view>
      <view wx:if="{{selectedStatus && selectedScene}}" class="combo-text">
        {{selectedStatus}} × {{selectedScene}}
        <text class="combo-ready">已就位</text>
      </view>
      <view wx:else class="combo-text">选好两项，这里会出现今天的组合</view>
    </view>
  </view>

  <view wx:if="{{noteExpanded}}" class="card reveal reveal-4">
    <view class="section-head">
      <view class="section-title">03 · 留一句话</view>
      <view class="counter">{{note.length}} / 100</view>
    </view>
    <textarea
      class="note-input"
      value="{{note}}"
      maxlength="100"
      placeholder="可选。今天想记住的一个细节……"
      placeholder-class="placeholder"
      bindinput="onNoteInput"
      auto-height
    />
    <view class="row-between" style="margin-top: 12rpx;">
      <view class="muted small">只保存在本机，也不会进入生成文案。</view>
      <view class="note-collapse" hover-class="btn-hover" bindtap="onCollapseNote">收起</view>
    </view>
  </view>

  <view wx:else class="card note-collapsed reveal reveal-4" hover-class="btn-hover" bindtap="onExpandNote">
    <view class="row-between">
      <view>
        <view class="section-title">03 · 留一句话</view>
        <view class="muted small note-collapsed__preview" style="margin-top: 6rpx;">{{note ? note : '可选，只保存在本机'}}</view>
      </view>
      <view class="note-collapsed__add">＋</view>
    </view>
  </view>

  <view class="cta-block reveal reveal-5">
    <button
      class="btn btn--primary"
      hover-class="btn-hover"
      loading="{{saving}}"
      disabled="{{saving || loading}}"
      bindtap="onSave"
    >{{hasEntry ? '更新今天的记录' : '保存今天的记录'}}</button>
    <button
      wx:if="{{hasEntry}}"
      class="btn btn--link cta-link"
      hover-class="btn-hover"
      bindtap="onOpenTodayResult"
    >查看今日碎片 ›</button>
    <view class="trust-line">只存在本机 · 不上传 · 随时可导出或清空</view>
  </view>
</view>
