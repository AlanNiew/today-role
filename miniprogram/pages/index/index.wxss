.home-page {
  padding-top: 16rpx;
}

.hero {
  overflow: hidden;
  padding: 16rpx 8rpx 26rpx;
  position: relative;
}

.hero__top {
  align-items: flex-start;
  display: flex;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}

.brand {
  align-items: center;
  display: flex;
}

.brand-mark {
  align-items: center;
  background: linear-gradient(145deg, #3a6a50, #244a37);
  border-radius: 50%;
  box-shadow: 0 12rpx 26rpx rgba(47, 93, 69, 0.2);
  color: #f7efdc;
  display: flex;
  font-size: 32rpx;
  height: 68rpx;
  justify-content: center;
  margin-right: 16rpx;
  width: 68rpx;
}

.hero__date {
  color: #5f6a5c;
  font-size: 25rpx;
  margin-top: 2rpx;
}

.hero__title {
  color: #22302a;
  font-size: 46rpx;
  font-weight: 500;
  line-height: 1.4;
  margin-top: 24rpx;
  position: relative;
  z-index: 2;
}

.hero__accent {
  color: #2f5d45;
  font-size: 62rpx;
  font-weight: 600;
}

.hero__sub {
  color: #5f675c;
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 10rpx;
  max-width: 100%;
  position: relative;
  z-index: 2;
}

.hero__orbit {
  border: 1rpx solid rgba(199, 154, 84, 0.26);
  border-radius: 50%;
  height: 270rpx;
  position: absolute;
  right: -110rpx;
  top: 24rpx;
  width: 270rpx;
}

.hero__orbit::after {
  border: 1rpx solid rgba(199, 154, 84, 0.16);
  border-radius: 50%;
  content: "";
  height: 170rpx;
  left: 49rpx;
  position: absolute;
  top: 49rpx;
  width: 170rpx;
}

.hero__orbit-dot {
  background: #c79a54;
  border-radius: 50%;
  box-shadow: 0 0 0 8rpx rgba(199, 154, 84, 0.14);
  height: 12rpx;
  position: absolute;
  right: 132rpx;
  top: 74rpx;
  width: 12rpx;
}

.combo-ready {
  color: #8a6a3d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-left: 12rpx;
}

.cta-block {
  margin-top: 6rpx;
}

.cta-link {
  margin-top: 2rpx;
}

/* 备注默认收起为一行，把主按钮留在首屏 */
.note-collapsed__add {
  align-items: center;
  background: #e7efe7;
  border-radius: 50%;
  color: #3c664d;
  display: flex;
  font-size: 30rpx;
  height: 56rpx;
  justify-content: center;
  width: 56rpx;
}

/* 已填写备注时，收起状态显示单行预览，避免看起来像被丢弃 */
.note-collapsed__preview {
  max-width: 470rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-collapse {
  color: #4f5c52;
  font-size: 23rpx;
  padding: 4rpx 0 4rpx 16rpx;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* 首页紧凑化：保证「保存 / 更新」按钮在常见机型首屏可见 */
.home-page .card {
  margin-bottom: 18rpx;
  padding: 28rpx 30rpx;
}

.home-page .section-head {
  margin: 8rpx 4rpx 14rpx;
}

.home-page .status-option {
  min-height: 106rpx;
}

.home-page .scene-option {
  min-height: 76rpx;
}

.home-page .combo-preview {
  margin-top: 16rpx;
  padding: 16rpx 22rpx;
}

/* 收起态比普通卡片更薄，进一步压缩首屏高度 */
.home-page .note-collapsed {
  padding: 20rpx 30rpx;
}
