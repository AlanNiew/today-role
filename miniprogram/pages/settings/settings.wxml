<view class="page">
  <view class="profile-hero reveal">
    <view class="row-between">
      <view class="row">
        <view class="profile-mark serif">今</view>
        <view style="margin-left: 18rpx;">
          <view class="eyebrow">MY DATA</view>
          <view style="color: #2a382f; font-size: 32rpx; font-weight: 600; margin-top: 2rpx;">你的记录</view>
        </view>
      </view>
      <view wx:if="{{showPro}}" class="tag {{isPro ? 'tag--gold' : 'tag--outline'}}">{{planText}}</view>
    </view>

    <view class="stats-row">
      <view class="stat-block">
        <view class="stat-block__value">{{recordedDays}}</view>
        <view class="stat-block__label">累计天数</view>
      </view>
      <view class="stat-block">
        <view class="stat-block__value">{{currentMonthDays}}</view>
        <view class="stat-block__label">本月记录</view>
      </view>
      <view class="stat-block">
        <view class="stat-block__value">{{streak}}</view>
        <view class="stat-block__label">连续记录</view>
      </view>
    </view>
    <view class="muted small" style="margin-top: 16rpx;">始于 {{firstDateLabel}}</view>
  </view>

  <view class="section-head">
    <view class="section-title">数据管理</view>
    <view class="section-note">只在本机</view>
  </view>
  <view class="list-card reveal reveal-2">
    <view class="list-row" hover-class="btn-hover" bindtap="onOpenHistory">
      <view class="row-icon row-icon--sage">史</view>
      <view class="row-body">
        <view class="row-title">历史记录</view>
        <view class="row-sub">按月份回看每天的记录与当天碎片</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="list-row" hover-class="btn-hover" bindtap="onExport">
      <view class="row-icon row-icon--sage">↓</view>
      <view class="row-body">
        <view class="row-title">导出 JSON</view>
        <view class="row-sub">复制到剪贴板，并写入本机临时文件</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="list-row list-row--danger" hover-class="btn-hover" bindtap="onClearAll">
      <view class="row-icon row-icon--danger">×</view>
      <view class="row-body">
        <view class="row-title">清空全部数据</view>
        <view class="row-sub">记录、缓存和 Mock 权益都会被删除</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">权益与探索</view>
  </view>
  <view class="list-card reveal reveal-3">
    <view wx:if="{{showPro}}" class="list-row" hover-class="btn-hover" bindtap="onOpenPaywall">
      <view class="row-icon row-icon--gold">PRO</view>
      <view class="row-body">
        <view class="row-title">Mock 权益</view>
        <view class="row-sub">{{isPro ? '已开通，可随时关闭' : '免费版完整可用；Pro 只加深解读'}}</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="list-row" hover-class="btn-hover" bindtap="onOpenWeekly">
      <view class="row-icon">7</view>
      <view class="row-body">
        <view class="row-title">本周角色快照</view>
        <view class="row-sub">最近 7 天的 2 个模式</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="list-row" hover-class="btn-hover" bindtap="onOpenMonthly">
      <view class="row-icon">月</view>
      <view class="row-body">
        <view class="row-title">本月角色卡</view>
        <view class="row-sub">状态分布、张力与行动建议</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <view class="card reveal reveal-4">
    <view class="section-head">
      <view class="section-title">隐私说明</view>
      <view class="tag tag--sage">本地</view>
    </view>
    <view class="privacy-list">
      <view class="privacy-item">不申请登录，不获取头像、昵称、手机号或位置。</view>
      <view class="privacy-item">不发起网络请求；规则生成全部在本地完成。</view>
      <view class="privacy-item">一句话备注不会用于生成文案，也不会出现在任何分享内容中。</view>
      <view class="privacy-item">数据只保存在本机；卸载小程序或更换设备会丢失，建议定期导出备份。</view>
      <view class="privacy-item">导出由你主动触发，JSON 只复制到剪贴板 / 本机临时文件。</view>
      <view class="privacy-item">内容只描述记录中的数量与共现，不做定性判断，也不构成医疗建议。</view>
    </view>
  </view>

  <view wx:if="{{showDevTools}}" class="dev-card reveal reveal-5">
    <view class="row-between">
      <view>
        <view class="section-title" style="color: #7a6a4f;">开发调试</view>
        <view class="muted small" style="margin-top: 4rpx;">最近 45 天演示数据，会覆盖现有记录</view>
      </view>
      <view class="tag tag--gold">会覆盖</view>
    </view>
    <button class="btn btn--ghost" style="margin-top: 20rpx;" hover-class="btn-hover" loading="{{seeding}}" bindtap="onSeedDemo">载入演示数据</button>
  </view>

  <view class="footer-note">
    今日角色 v{{appVersion}} · 数据 schema 2 · 非医疗建议
  </view>
</view>
