<view class="page">
  <view class="page-head reveal">
    <view>
      <view class="eyebrow">MONTHLY CARD</view>
      <view class="display" style="margin-top: 6rpx;">月度回顾</view>
    </view>
    <view class="tag tag--outline" wx:if="{{monthShort}}">{{monthShort}}</view>
  </view>

  <view wx:if="{{loading}}" class="empty">
    <view class="empty-title">正在整理</view>
    <view class="muted">把这个月的记录摊开看看…</view>
  </view>

  <view wx:elif="{{error}}" class="card center">
    <view class="empty-title">这次没有生成成功</view>
    <view class="muted" style="margin: 12rpx 0 28rpx;">{{error}}</view>
    <button class="btn btn--primary" hover-class="btn-hover" bindtap="onGoRecord">回到记录页</button>
  </view>

  <block wx:elif="{{blocked}}">
    <view class="card reveal reveal-2">
      <view class="section-head">
        <view class="section-title">{{monthLabel}}</view>
        <view class="tag tag--gold">{{recordedDays}} / {{requiredDays}} 天</view>
      </view>
      <view class="gate-number">
        <text class="gate-number__value">{{requiredDays - recordedDays}}</text>
        <text class="gate-number__unit">天</text>
      </view>
      <view class="muted" style="margin-bottom: 24rpx;">{{message}}</view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progress}}%;"></view>
      </view>
      <view class="row-between muted small" style="margin-top: 12rpx;">
        <view>本月已记录 {{recordedDays}} 天</view>
        <view>满 {{requiredDays}} 天生成基础版</view>
      </view>
    </view>

    <view class="card card--tint reveal reveal-3">
      <view class="section-head">
        <view class="section-title">月卡会看到什么</view>
        <view class="tag tag--sage">免费</view>
      </view>
      <view class="muted">6 个状态的天数分布、出现最多的 2 个场景、一句例外 / 张力，以及一条轻量行动建议。</view>
    </view>

    <button class="btn btn--primary reveal reveal-4" hover-class="btn-hover" bindtap="onGoRecord">去记录今天</button>
  </block>

  <block wx:else>
    <view class="month-cover reveal reveal-2">
      <view class="cover-orbit"></view>
      <view class="row-between" style="position: relative; z-index: 1;">
        <view class="cover-eyebrow">MONTHLY · {{monthShort}}</view>
        <view class="tag tag--dark">{{planText}}</view>
      </view>
      <view class="cover-title">{{monthLabel}}</view>
      <view style="align-items: baseline; display: flex; margin-top: 14rpx; position: relative; z-index: 1;">
        <text class="cover-number">{{recordedDays}}</text>
        <text class="cover-unit">天记录</text>
      </view>
    </view>

    <view class="card reveal reveal-3">
      <view class="section-head">
        <view class="section-title">状态分布</view>
        <view class="section-note">共 {{recordedDays}} 天</view>
      </view>
      <view wx:for="{{distribution}}" wx:key="status" class="dist-row">
        <view class="dist-head">
          <view class="dist-name">
            <view class="dist-dot" style="background: {{item.color}};"></view>
            <text>{{item.status}}</text>
          </view>
          <view>{{item.count}} 天 · {{item.percent}}%</view>
        </view>
        <view class="dist-track">
          <view class="dist-fill" style="width: {{item.percent}}%; background: {{item.color}};"></view>
        </view>
      </view>
    </view>

    <view class="card reveal reveal-3">
      <view class="section-head">
        <view class="section-title">高频场景 Top 2</view>
        <view class="section-note">按记录天数</view>
      </view>
      <view wx:if="{{topScenes.length === 0}}" class="muted">本月还没有场景数据。</view>
      <view wx:else class="scene-tiles">
        <view wx:for="{{topScenes}}" wx:key="scene" class="scene-tile">
          <view class="scene-tile__name">{{item.scene}}</view>
          <view class="scene-tile__count">{{item.count}} 天 · {{item.percent}}%</view>
        </view>
      </view>
    </view>

    <view class="quote-card reveal reveal-4">
      <view class="quote-mark">“</view>
      <view class="quote-text">{{tension}}</view>
    </view>

    <view class="action-card reveal reveal-4" style="margin-top: 22rpx;">
      <view class="action-kicker">LIGHT ACTION · 基础版</view>
      <view class="action-text">{{actionSuggestion}}</view>
    </view>

    <view class="section-head" style="margin-top: 40rpx;">
      <view class="section-title">更深一层</view>
      <view class="section-note">Mock 权益控制</view>
    </view>

    <block wx:if="{{isPro && insights}}">
      <view class="pro-panel reveal">
        <view class="row-between">
          <view class="cover-eyebrow">MOCK PRO · DEEP READ</view>
          <view class="tag tag--dark">已开通</view>
        </view>
        <view class="pro-panel__title">触发 / 共现观察</view>
        <view wx:for="{{insights.triggers}}" wx:key="*this" class="pro-trigger">{{item}}</view>
        <view class="pro-divider"></view>
        <view class="pro-panel__label">共现摘要</view>
        <view class="pro-panel__text">{{insights.coOccurrence}}</view>
      </view>

      <view class="card reveal">
        <view class="section-head">
          <view class="section-title">本月 vs 上月</view>
          <view class="tag {{insights.comparison.available ? 'tag--sage' : 'tag--gold'}}">
            {{insights.comparison.available ? '可对比' : '数据不足'}}
          </view>
        </view>
        <view class="muted" style="font-size: 28rpx;">{{insights.comparison.summary}}</view>
        <view wx:if="{{insights.comparison.available}}" class="compare-line">
          <view class="compare-line__label">主导状态</view>
          <view class="compare-line__text">{{insights.comparison.statusShift}}</view>
        </view>
        <view wx:if="{{insights.comparison.available}}" class="compare-line">
          <view class="compare-line__label">高频场景</view>
          <view class="compare-line__text">{{insights.comparison.sceneShift}}</view>
        </view>
      </view>

      <view class="card card--tint reveal">
        <view class="section-head">
          <view class="section-title">完整行动建议</view>
          <view class="tag tag--sage">3 条</view>
        </view>
        <view wx:for="{{insights.actionPlan}}" wx:key="*this" class="action-item">
          <view class="action-index">0{{index + 1}}</view>
          <view class="action-item__text">{{item}}</view>
        </view>
        <view class="muted small" style="margin-top: 18rpx;">建议只基于记录中的共现，不构成医疗建议。</view>
      </view>
    </block>

    <view wx:elif="{{isPro}}" class="card center">
      <view class="empty-title">深度内容暂时没有生成</view>
      <view class="muted" style="margin: 12rpx 0 24rpx;">基础月卡不受影响，可以重新加载试试。</view>
      <button class="btn btn--ghost" hover-class="btn-hover" bindtap="onRefresh">重新加载</button>
    </view>

    <view wx:else class="pro-lock reveal">
      <view class="row-between">
        <view class="section-title" style="color: #8a6a3d;">MOCK PRO</view>
        <view class="tag tag--gold">开发测试</view>
      </view>
      <view class="pro-lock__title">把共现读得更深一点</view>
      <view class="muted" style="color: #7a694e; margin: 8rpx 0 18rpx;">
        免费版已包含分布、Top 场景、张力与一句建议。以下内容由本机 mock 开关控制，不接真实支付：
      </view>
      <view class="pro-feature">触发 / 共现观察，明确标注不代表因果</view>
      <view class="pro-feature">本月 vs 上月历史对比</view>
      <view class="pro-feature">3 条完整行动建议</view>
      <button class="btn btn--gold" style="margin-top: 26rpx;" hover-class="btn-hover" bindtap="onOpenPaywall">了解 Mock Pro</button>
    </view>

    <button class="btn btn--link" hover-class="btn-hover" bindtap="onGoRecord">补记 / 修改今天</button>
  </block>

  <view class="footer-note">仅供自我观察，不构成医疗建议。所有数据只存在本机。</view>
</view>
