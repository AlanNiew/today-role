{
  "name": "today-role",
  "version": "0.1.0",
  "private": true,
  "description": "今日角色：每天 5 秒记录状态的微信小程序 MVP",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{json,md,mjs,ts,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{json,md,mjs,ts,yml,yaml}\"",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:structure"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "miniprogram-api-typings": "^5.3.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": ">=22"
  }
}
